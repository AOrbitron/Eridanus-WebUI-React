{
  "name": "ant-design-pro",
  "version": "6.0.0",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "description": "An out-of-box UI solution for enterprise applications",
  "scripts": {
    "analyze": "cross-env ANALYZE=1 max build",
    "build": "max build",
    "deploy": "npm run build && npm run gh-pages",
    "dev": "npm run start:dev",
    "gh-pages": "gh-pages -d dist",
    "i18n-remove": "pro i18n-remove --locale=zh-CN --write",
    "postinstall": "max setup",
    "jest": "jest",
    "lint": "npm run lint:js && npm run lint:prettier && npm run tsc",
    "lint-staged": "lint-staged",
    "lint-staged:js": "eslint --ext .js,.jsx,.ts,.tsx ",
    "lint:fix": "eslint --fix --cache --ext .js,.jsx,.ts,.tsx --format=pretty ./src ",
    "lint:js": "eslint --cache --ext .js,.jsx,.ts,.tsx --format=pretty ./src",
    "lint:prettier": "prettier -c --write \"**/**.{js,jsx,tsx,ts,less,md,json}\" --end-of-line auto",
    "openapi": "max openapi",
    "prepare": "husky install",
    "prettier": "prettier -c --write \"**/**.{js,jsx,tsx,ts,less,md,json}\"",
    "preview": "npm run build && max preview --port 5007",
    "record": "cross-env NODE_ENV=development REACT_APP_ENV=test max record --scene=login",
    "serve": "umi-serve",
    "start": "cross-env UMI_ENV=dev max dev",
    "start:dev": "cross-env REACT_APP_ENV=dev UMI_ENV=dev max dev",
    "start:no-mock": "cross-env MOCK=none UMI_ENV=dev max dev",
    "start:pre": "cross-env REACT_APP_ENV=pre UMI_ENV=dev max dev",
    "start:test": "cross-env REACT_APP_ENV=test MOCK=none UMI_ENV=dev max dev",
    "test": "jest",
    "test:coverage": "npm run jest -- --coverage",
    "test:update": "npm run jest -- -u",
    "tsc": "tsc --noEmit"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx}": "npm run lint-staged:js",
    "**/*.{js,jsx,tsx,ts,less,md,json}": [
      "prettier --write"
    ]
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not ie <= 10"
  ],
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@ant-design/pro-components": "^3.1.14-2",
    "@ant-design/x": "^2.9.0",
    "@ant-design/x-markdown": "^2.9.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "antd": "^6.6.0",
    "classnames": "^2.5.1",
    "framer-motion": "^12.24.12",
    "js-sha3": "^0.9.3",
    "lodash": "^4.17.21",
    "markdown-it": "^14.1.0",
    "moment": "^2.30.1",
    "omit.js": "^2.0.2",
    "querystring": "^0.2.1",
    "rc-field-form": "^2.7.1",
    "rc-menu": "^9.16.1",
    "rc-queue-anim": "^2.0.0",
    "rc-util": "^5.44.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.0",
    "react-viewer": "^3.2.2"
  },
  "devDependencies": {
    "@ant-design/pro-cli": "^3.4.0",
    "@testing-library/react": "^16.3.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.21",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@umijs/lint": "^4.7.3",
    "@umijs/max": "^4.7.3",
    "@umijs/request-record": "^1.1.4",
    "cross-env": "^10.1.0",
    "eslint": "^8.57.1",
    "express": "^5.2.1",
    "gh-pages": "^6.3.0",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "lint-staged": "^16.2.7",
    "mockjs": "^1.1.0",
    "prettier": "^3.7.4",
    "swagger-ui-dist": "^5.31.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "umi-serve": "^1.9.11"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "antd": "$antd",
    "@umijs/plugins": {
      "@ant-design/pro-components": "$@ant-design/pro-components",
      "axios": "^1.19.0"
    }
  },
  "pnpm": {
    "overrides": {
      "antd": "$antd",
      "@umijs/plugins>@ant-design/pro-components": "$@ant-design/pro-components",
      "@umijs/plugins>axios": "^1.19.0"
    }
  }
}
